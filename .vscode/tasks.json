{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup Environment",
      "type": "shell",
      "windows": {
        "command": ".\\scripts\\setup-diii.ps1"
      },
      "linux": {
        "command": "source scripts/setup-diii.sh"
      },
      "osx": {
        "command": "source scripts/setup-diii.sh"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Clear Environment",
      "type": "shell",
      "windows": {
        "command": "rmdir .venv -r -Force"
      },
      "linux": {
        "command": "rm -rf .venv"
      },
      "osx": {
        "command": "rm -rf .venv"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Launch diii",
      "type": "shell",
      "windows": {
        "command": ".\\.venv\\Scripts\\Activate.ps1; diii"
      },
      "osx": {
        "command": "source .venv/bin/activate && diii"
      },
      "linux": {
        "command": "source .venv/bin/activate && diii"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Flash iiiano",
      "type": "shell",
      "windows": {
        "command": "& .\\.venv\\Scripts\\diii.exe do '^^c'; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; & .\\.venv\\Scripts\\diii.exe upload src/grid/iiiano.lua; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; & .\\.venv\\Scripts\\diii.exe do 'fs_run_file(''lib.lua''); fs_run_file(''iiiano.lua'')'; exit $LASTEXITCODE"
      },
      "osx": {
        "command": ".venv/bin/diii do '^^c' && .venv/bin/diii upload src/grid/iiiano.lua && .venv/bin/diii do \"fs_run_file('lib.lua'); fs_run_file('iiiano.lua')\""
      },
      "linux": {
        "command": ".venv/bin/diii do '^^c' && .venv/bin/diii upload src/grid/iiiano.lua && .venv/bin/diii do \"fs_run_file('lib.lua'); fs_run_file('iiiano.lua')\""
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Test",
      "type": "shell",
      "windows": {
        "command": ".\\scripts\\test.ps1"
      },
      "osx": {
        "command": "bash scripts/test.sh"
      },
      "linux": {
        "command": "bash scripts/test.sh"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Lock Dependencies",
      "type": "shell",
      "windows": {
        "command": ".\\.venv\\Scripts\\Activate.ps1; pip freeze > requirements.txt"
      },
      "osx": {
        "command": "source .venv/bin/activate && pip freeze > requirements.txt"
      },
      "linux": {
        "command": "source .venv/bin/activate && pip freeze > requirements.txt"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": false
      }
    }
  ]
}
